                locality: document.getElementById('locality').value,
                type: document.getElementById('type').value,
                price: Number(document.getElementById('price').value),
                contact: document.getElementById('contactNumber').value || "7906824135",
                image: document.getElementById('image').value || "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=600",
                badge: "Newly Added"
            };

            workspaces.unshift(newSpace);
            localStorage.setItem('space_bazaar_all_listings', JSON.stringify(workspaces));
            
            closeAddModal();
            document.getElementById('addListingForm').reset();
            
