        function filterListings() {
            const city = document.getElementById('searchCity').value;
            const type = document.getElementById('searchType').value;
            const keyword = document.getElementById('searchKeyword').value.toLowerCase();

            const filtered = workspaces.filter(item => {
                const matchesCity = (city === 'All') || (item.city.toLowerCase() === city.toLowerCase());
                const matchesType = (type === 'All') || (item.type.toLowerCase() === type.toLowerCase());
                const matchesKeyword = item.title.toLowerCase().includes(keyword) || item.locality.toLowerCase().includes(keyword);

                return matchesCity && matchesType && matchesKeyword;
            });

            renderListings(filtered);
        }

        function selectCityFilter(cityName) {
            document.getElementById('searchCity').value = cityName;
            filterListings();
            document.getElementById('listings').scrollIntoView({ behavior: 'smooth' });
